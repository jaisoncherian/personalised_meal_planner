SPOONACULAR_API_KEY=your_spoonacular_api_key
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Supabase → Project Settings → API. Accounts and all app data are stored there (schema: supabase/schema.sql).
# The secret key is server-only and bypasses Row Level Security; never put it in a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Optional: AUTH_STORE=memory keeps accounts and data in memory instead (lost on restart), for trying the app without Supabase.
# AUTH_STORE=memory
